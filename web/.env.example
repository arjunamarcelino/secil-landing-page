# Sanity — public, non-secret values (shipped in client request URLs by design).
# Leave PROJECT_ID as "your_project_id" to run the site on local fallback content.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01

# Absolute origin used for metadata, canonical URLs, sitemap and robots.
# Not a hosting decision — just the base URL used to build absolute links.
NEXT_PUBLIC_SITE_URL=https://senyumkecilmedan.org

# NOTE: A Sanity *read token* (for draft/preview) must be added ONLY when needed,
# named WITHOUT the NEXT_PUBLIC_ prefix, and read from server code only. Never here.
